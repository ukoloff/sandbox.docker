{
  "name": "sdcr.sh",
  "dockerComposeFile": "./compose.yml",
  "service": "bash",
  "onCreateCommand": "apt update; apt install -yq procps git shellcheck shfmt",
  "postCreateCommand": "sh /bin/repo.clone.sh",
  "postStartCommand": "sh /bin/repo.pull.sh",
  "workspaceFolder": "/repo",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "fabiospampinato.vscode-open-in-github",
        "mhutchie.git-graph",
        "rogalmic.bash-debug",
        "mads-hartmann.bash-ide-vscode",
        "timonwong.shellcheck"
      ]
    }
  }
}
